# ============================================================
# dinggang CRM 环境变量配置示例
# 复制为 .env 并修改实际值，.env 不提交到Git
# ============================================================

# MySQL配置
DB_ROOT_PASSWORD=root123456
DB_NAME=dinggang_crm
DB_USER=dinggang
DB_PASSWORD=dinggang123

# Redis配置
REDIS_PASSWORD=redis123

# MinIO对象存储
MINIO_USER=minioadmin
MINIO_PASSWORD=minioadmin123

# AES加密密钥 (32字节Base64)
# 生产环境请用 openssl rand -base64 32 生成新密钥
AES_KEY=ZGVmYXVsdC1hZXMta2V5LXNlZWQtMzJieXRlcw==

# LLM大模型配置 (通义千问)
LLM_API_KEY=your-api-key-here
LLM_BASE_URL=https://dashscope.aliyuncs.com/api/v1
LLM_MODEL=qwen-plus
